<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="TrackGuests - Luxury Guest Management" suffix=" · TrackGuests">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="gradient-bg-luxury font-['Open_Sans'] text-gray-900 antialiased">
    <ul class="menu menu-horizontal w-full relative z-10 flex items-center gap-4 px-4 sm:px-6 lg:px-8 justify-end glass-luxury border-b border-gray-200/50 py-2">
      <!-- Theme Toggle -->
      <li class="flex items-center gap-2">
        <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
        <button id="theme-toggle" class="theme-toggle" onclick="toggleTheme()">
          <span class="theme-toggle-handle"></span>
        </button>
        <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
      </li>

      <%= if @current_scope do %>
        <li class="text-sm text-gray-600 font-medium">
          <%= (is_struct(@current_scope) && Map.get(@current_scope, :user) && Map.get(Map.get(@current_scope, :user, %{}), :email)) || "User" %>
        </li>
        <%= if @current_scope && Map.get(@current_scope, :user) && Map.get(Map.get(@current_scope, :user, %{}), :admin) do %>
          <li>
            <.link href={~p"/admin"} class="nav-link-luxury text-sm">Admin</.link>
          </li>
        <% end %>
        <li>
          <.link href={~p"/guides"} class="nav-link-luxury text-sm">
            <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
            Guides
          </.link>
        </li>
        <li>
          <.link href={~p"/users/settings"} class="nav-link-luxury text-sm">Settings</.link>
        </li>
        <li>
          <.link href={~p"/users/log-out"} method="delete" class="nav-link-luxury text-sm">Log out</.link>
        </li>
      <% else %>
        <li>
          <.link href={~p"/guides"} class="nav-link-luxury text-sm">
            <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
            Guides
          </.link>
        </li>
        <li>
          <.link href={~p"/users/register"} class="nav-link-luxury text-sm">
            <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
            </svg>
            Register
          </.link>
        </li>
        <li>
          <.link href={~p"/users/log-in"} class="nav-link-luxury text-sm">
            <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
            </svg>
            Log in
          </.link>
        </li>
      <% end %>
    </ul>

    <script>
      function toggleTheme() {
        const html = document.documentElement;
        const toggle = document.getElementById('theme-toggle');
        const currentTheme = html.getAttribute('data-theme');
        const newTheme = currentTheme === 'light' ? 'dark' : 'light';
        
        html.setAttribute('data-theme', newTheme);
        toggle.classList.toggle('dark');
        localStorage.setItem('theme', newTheme);
      }

      // Load saved theme or default to light
      const savedTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
      if (savedTheme === 'dark') {
        document.getElementById('theme-toggle').classList.add('dark');
      }
    </script>

    {@inner_content}
  </body>
</html>

